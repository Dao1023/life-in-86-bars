# ── 发布排除项 ──────────────────────────────────────────────
# 原始抓取包：154MB，只发布派生产物
/raw/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 构建中间产物（临时分块、调试导出）
/viz/_tmp/

# 调研探针的原始 JSON（一次性抓取，几十个文件）
/notes/probe/

# 审计过程备份
/notes/.audit_backup/

# ── 系统杂项 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.log
viz/index-step*-1440.png
_publish/
